# /etc/systemd/system/youless.service
[Unit]
Description=Youless Reader (runs youless_reader.py inside Python venv)

# The database runs in Docker on the same host, so the reader must not start
# before dockerd. Until 2026-08-29 this said only network-online.target, and
# every boot lost the race: observed on pi4 after the kernel upgrade that day --
#   19:45:46 youless started
#   19:45:49 ERROR connecting to database: localhost:5432 Connection refused
#   19:45:52 restart 1 -- server closed the connection unexpectedly
#   19:45:54 docker started
#   19:45:56 youless started, succeeded
# Restart=always always recovered it, so it looked harmless. patricia raced too
# and simply won a retry sooner.
After=network-online.target docker.service
Wants=network-online.target docker.service

# Ordering after dockerd narrows the race but cannot close it: dockerd being
# active is not the container accepting connections on 5432. So the retry loop
# must never be allowed to give up. systemd's default is StartLimitBurst=5
# within StartLimitIntervalSec=10s, and a unit that trips that limit is not
# retried again -- it just stays dead. On a cold boot or a slow SD card that is
# a realistic outcome, and a silently dead reader is exactly the failure this
# unit's watchdog was added for after the 98-day pi4 outage. 0 disables the
# limit: keep retrying forever and let youless-freshness.timer raise the alarm,
# which is the behaviour worth having. A genuinely broken reader then restarts
# every RestartSec=3 and is loud in the journal rather than quiet and stopped.
StartLimitIntervalSec=0

[Service]
# --- Adjust these paths and user/group ---
User=daemon
Group=daemon
WorkingDirectory=/opt/youless
# see https://chatgpt.com/s/t_694b156f37dc8191a5740da448e44641 for dealing with env vars
# -----------------------------------------

# Environment (optional but useful)
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
# install the file below locally on the node, it has the postgress credentials
EnvironmentFile=-/etc/youless/youless.env

# the actual executable. It starts the python env, and starts the script
# DEPENDS ON WorkingDirectory
ExecStart=/opt/youless/.venv/bin/python /opt/youless/src/youless_reader.py

# Restart policy
Restart=always
RestartSec=3
# Stop gracefully
KillSignal=SIGINT
TimeoutStopSec=30

# Watchdog.
# On 2026-05-18 the reader on pi4 blocked forever in recvfrom() on a half-open
# TCP socket to the meter: the meter accepted the connection and then stopped
# replying, sending neither FIN nor RST. The process stayed alive and systemd
# kept reporting "active (running)", so Restart=always never fired and capture
# was silently dead for 98 days.
#
# The reader now pings WATCHDOG=1 once per loop iteration (at most ~10s apart).
# If the loop stops turning, systemd kills the unit and Restart=always brings it
# back. NotifyAccess is required for a Type=simple service to be permitted to
# send those pings.
#
# NOTE: this unit and src/youless_reader.py must be deployed TOGETHER. Older
# code does not ping, so installing this unit alone would make systemd kill the
# reader every 60 seconds. deploy_youless.sh installs both in one pass.
NotifyAccess=main
WatchdogSec=60

# Journald logs
StandardOutput=journal
StandardError=journal

# Hardening (safe defaults; relax if your script needs more)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/youless

[Install]
WantedBy=multi-user.target
