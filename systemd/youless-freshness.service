# /etc/systemd/system/youless-freshness.service
#
# Outcome check: is every node still writing rows? Complements the watchdog in
# youless.service, which only proves the reader's loop is turning.
#
# Triggered by youless-freshness.timer, not enabled directly.
# On failure the unit enters failed state, so `systemctl --failed` and
# `journalctl -u youless-freshness` both show it.

[Unit]
Description=Check that youless capture is still writing rows on every node
After=network-online.target
Wants=network-online.target

# Push the failure to a phone. Entering failed state only shows up in
# `systemctl --failed` and the journal, which are both PULL signals -- they help
# only if somebody looks, and nobody looked for 98 days.
# %N is this unit's own name WITHOUT the .service suffix, so the notifier knows
# what died. Use %N and not %n: %n keeps the suffix, which lands you with a unit
# called youless-notify@youless-freshness.service.service.
OnFailure=youless-notify@%N.service

[Service]
Type=oneshot

# PGUSER / PGPASSWORD / PGDATABASE / NODES / MAX_LAG_SECONDS
# Install this file yourself on each node; it holds the database password.
EnvironmentFile=/etc/youless/freshness.env

# Runs from the application venv, not from /usr/bin/python3. Until 2026-08-29 this
# said /usr/bin/python3, which only worked because that symlink had been repointed
# away from Debian's python3 to a hand-built interpreter in /usr/local -- the only
# place psycopg2 was installed. Restoring the symlink to what dpkg ships therefore
# broke this unit, and nothing else on the box, which is a bad way to find out.
# The venv owns its dependencies, so this line no longer depends on what
# /usr/bin/python3 happens to point at.
ExecStart=/opt/youless/.venv/bin/python /usr/local/sbin/youless-freshness.py

# psql is deliberately not used: pi4 has no postgresql-client package,
# while the venv built by the deploy already carries psycopg2.

# Hardening: this only needs to open outbound database connections.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
